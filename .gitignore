# ---- 虚拟环境 ----
.venv/
venv/
env/

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/

# ---- 本地运行时数据（数据库由 `cli db init` 重建，不入库）----
data/*.db
data/*.db-wal
data/*.db-shm

# ---- 运行时冒烟产物与临时探针（保留 artifacts/intake 与 artifacts/reports）----
artifacts/runs/
artifacts/tmp/
*.tmp

# ---- 验收/实验草稿区（证据留在磁盘上供复核，但一律不随产品交付、不入库）----
/probe/

# ---- 流程探针的可再生产物（PDF 副本 / 探针库 / 抽取出的图片，均可复跑重生成）----
.agent-runs/**/probe/pdf/
.agent-runs/**/probe/**/*.sqlite
.agent-runs/**/probe/**/*.sqlite.prev
.agent-runs/**/probe/**/*.db

# ---- 工作区内部元数据（不删除，仅不入库）----
.workbuddy/

# ---- 误生成的 0 字节杂散文件（2026-10-13 CLI 测试残留，不纳入版本库）----
/human

# ---- 编辑器 / 系统 ----
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ---- 历年真题/论文素材（2026-10-19 第 24 轮）----
# 目录合计 892,194,088 B（du -sh 854M）；其中 manifest 覆盖的 1380 个素材文件
# = 733,637,993 B（10 真题 PDF + 69 附件 + 23 篇论文 1301 页扫描图），
# _bundle/ 另有 157,634,704 B 官方原始 zip。体量不适合入库。
# `manifest.json` 保留（离线可重建清单 + sha256 溯源），
# 二进制由 `.agent-runs/2026-10-19/task-003/fetch_corpus.py` 重跑恢复（幂等）。
artifacts/exam_corpus/exams/
artifacts/exam_corpus/papers/
artifacts/exam_corpus/_bundle/
artifacts/exam_corpus/_assets.json
artifacts/exam_corpus/fetch_report.json

# ---- FR-4 向量索引（2026-10-22 第 36 轮）----
# 生成物：`cli rag rebuild` 用同一份语料 + 同一模型**完整可复现**（manifest 里逐份
# 记 sha256，vectors.jsonl 每行一块），故不入库（task-004 README §1「不入库」）。
# 现规模：33 块 / dims 1024 / 约 780 KB。
artifacts/rag/index/
